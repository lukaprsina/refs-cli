#!/usr/bin/env bash
# Fails when a markdown file or Rust source mentions an ADR file, or links to a
# repo-relative markdown file, that does not exist.
set -euo pipefail
cd "$(dirname "$0")/.."

status=0
fail() { echo "$1: points at missing $2" >&2; status=1; }

files=$(git ls-files '*.md' '*.rs' ':!:docs/private/**' ':!:docs/agents/**')

for f in $files; do
  # ADR file names, e.g. 0006-sync-plan.md
  for adr in $(grep -oE '[0-9]{4}-[a-z0-9-]+\.md' "$f" | sort -u); do
    [ -e "docs/adr/$adr" ] || fail "$f" "docs/adr/$adr"
  done
  # relative markdown links, e.g. [x](../GLOSSARY.md#term)
  case "$f" in *.md)
    for link in $(grep -oE '\]\([^)#]+\.md' "$f" | sed 's/^](//' | sort -u); do
      case "$link" in http*) continue ;; esac
      [ -e "$(dirname "$f")/$link" ] || fail "$f" "$link"
    done ;;
  esac
done
exit $status
