#!/usr/bin/env bash
# Usage: scripts/mutants user@host [cargo-mutants args]
# Copies scripts/mutants-remote to the server, runs it in tmux (survives ssh drops),
# and with --fetch as the only extra argument downloads the finished tarball into mutants-results/.
set -euo pipefail
cd "$(dirname "$0")/.."
host=${1:?usage: scripts/mutants user@host [--fetch | cargo-mutants args]}
shift

# Some tests rely on permission bits (root ignores them), so everything runs as an
# unprivileged user, created on first use when given root@host.
if [ "${host%%@*}" = root ]; then
    ssh "$host" 'id -u mutants >/dev/null 2>&1 || {
        useradd -m -s /bin/bash mutants
        echo "mutants ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/mutants
        install -d -m 700 -o mutants -g mutants /home/mutants/.ssh
        install -m 600 -o mutants -g mutants /root/.ssh/authorized_keys /home/mutants/.ssh/authorized_keys
    }'
    host=mutants@${host#*@}
fi

if [ "${1:-}" = "--fetch" ]; then
    mkdir -p mutants-results
    scp "$host:mutants-*.tgz" mutants-results/
    exit 0
fi

# Windows checkouts may have CRLF line endings, which bash cannot run.
tr -d '\r' < scripts/mutants-remote | ssh "$host" 'cat > mutants-remote'
ssh "$host" "tmux new -d -s mutants 'JOBS=${JOBS:-4} bash mutants-remote $* 2>&1 | tee run.log'"
echo "started; follow with: ssh $host tmux attach -t mutants"
echo "then fetch with:      scripts/mutants $host --fetch"
